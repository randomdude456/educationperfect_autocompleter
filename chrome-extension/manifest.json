{
  "manifest_version": 3,
  "name": "EP Auto",
  "version": "5.0.0",
  "description": "EP vocabulary helper with manual start, pacing, cooldowns, and safe pauses.",
  "content_scripts": [
    {
      "matches": [
        "https://app.educationperfect.com/*",
        "https://*.educationperfect.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "storage"
  ]
}
