{
  "manifest_version": 3,
  "name": "EP Helper",
  "version": "5.1.0",
  "description": "Shows matching Education Perfect vocabulary answers and lets the user copy or fill them manually.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://app.educationperfect.com/*",
        "https://*.educationperfect.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
